# =============================================================================
# Digital Ocean Migration Environment Configuration Template
# =============================================================================

# -----------------------------------------------------------------------------
# Digital Ocean Infrastructure & Credentials
# -----------------------------------------------------------------------------
DO_TOKEN=dop_v1_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ENVIRONMENT=prod
DO_REGION=nyc1
DO_VPC_CIDR=10.136.0.0/16
SSH_PUBLIC_KEY="ssh-rsa AAAAB3NzaC1yc2EAAAADAQABAAABgQC..."

# -----------------------------------------------------------------------------
# HashiCorp Consul & Nomad Cluster
# -----------------------------------------------------------------------------
CONSUL_HTTP_ADDR=http://127.0.0.1:8500
NOMAD_ADDR=http://127.0.0.1:4646
DATACENTER=dc1
STATE_BACKEND=consul # 'consul' or 'file'

# -----------------------------------------------------------------------------
# Apache Kafka Messaging Broker
# -----------------------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=kafka.service.consul:9092
KAFKA_DLQ_TOPIC=extractions.dlq
POLL_INTERVAL_SECONDS=60
BATCH_SIZE=100
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Grafana Monitoring Hub
# -----------------------------------------------------------------------------
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change_this_to_a_strong_password_123!
GRAFANA_HTTP_PORT=3000

# -----------------------------------------------------------------------------
# Microsoft Graph Extraction Service
# -----------------------------------------------------------------------------
MS_TENANT_ID=00000000-0000-0000-0000-000000000000
MS_CLIENT_ID=00000000-0000-0000-0000-000000000000
MS_CLIENT_SECRET=ms_graph_secret_value_here
KAFKA_TOPIC_MICROSOFT=extractions.microsoft

# -----------------------------------------------------------------------------
# HubSpot CRM Extraction Service
# -----------------------------------------------------------------------------
HUBSPOT_ACCESS_TOKEN=pat-na1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
RATE_LIMIT_PER_SECOND=10
KAFKA_TOPIC_HUBSPOT=extractions.hubspot

# -----------------------------------------------------------------------------
# Salesforce CRM Extraction Service
# -----------------------------------------------------------------------------
SF_CLIENT_ID=3MVG9xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SF_CLIENT_SECRET=sf_client_secret_value_here
SF_USERNAME=devops-admin@company.com
SF_PASSWORD=your_salesforce_password
SF_SECURITY_TOKEN=your_salesforce_security_token
SF_INSTANCE_URL=https://login.salesforce.com
KAFKA_TOPIC_SALESFORCE=extractions.salesforce
