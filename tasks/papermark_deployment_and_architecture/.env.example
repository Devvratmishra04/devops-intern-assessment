# ==============================================================================
# Papermark Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application & Domain Setup
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Papermark"
NEXT_PUBLIC_APP_DESCRIPTION="Open-source document sharing alternative to DocSend."

# ------------------------------------------------------------------------------
# 2. Database Connection (PostgreSQL - Prisma ORM)
# ------------------------------------------------------------------------------
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:papermark_secure_pass@postgres:5432/papermark?schema=public&connection_limit=20&pool_timeout=30"

# Direct URL for migrations (if using PgBouncer/Supabase connection pooling)
DIRECT_URL="postgresql://postgres:papermark_secure_pass@postgres:5432/papermark?schema=public"

# ------------------------------------------------------------------------------
# 3. Authentication (NextAuth.js)
# ------------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="e9f0c2a87b14d89a9c3b8e4f1a2d5e7c8b0a9f3e6d2c1b5a8f7e4d1c9b2a5f8"
NEXTAUTH_URL="http://localhost:3000"

# Optional: Email / Magic Link Provider (Resend, SendGrid, or SMTP)
RESEND_API_KEY=""
EMAIL_FROM="notifications@papermark.io"

# Optional: Social OAuth Providers
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ------------------------------------------------------------------------------
# 4. Storage Layer (S3 / Cloudflare R2 / MinIO Compatible)
# ------------------------------------------------------------------------------
# S3 / MinIO / R2 Endpoint
S3_ENDPOINT="http://minio:9000"
S3_REGION="auto"
S3_BUCKET="papermark-documents"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadminpass"

# Set to true if using local MinIO or custom path-style addressing
S3_FORCE_PATH_STYLE="true"

# Public CDN or Direct Gateway URL for preview assets (if configured)
NEXT_PUBLIC_S3_CDN_URL=""

# ------------------------------------------------------------------------------
# 5. Analytics Engine (Tinybird or PostgreSQL Fallback)
# ------------------------------------------------------------------------------
TINYBIRD_API_KEY=""
TINYBIRD_API_URL="https://api.tinybird.co"
NEXT_PUBLIC_TINYBIRD_TOKEN=""

# ------------------------------------------------------------------------------
# 6. Observability & Security
# ------------------------------------------------------------------------------
CRON_SECRET="b8f1c4e97a2d3b5c8e1f4a7d0c2b5e8a"
NODE_ENV="production"
